# Copy this file to deploy/.env and fill in your SmarterASP.NET FTP details.
# deploy/.env is gitignored — credentials never get committed.

FTP_HOST=ftp.yourhost.smarterasp.net
FTP_USER=your-ftp-username
FTP_PASS=your-ftp-password

# Document root on the host where index.html should land.
# On SmarterASP.NET this is often "/" or "/wwwroot".
FTP_REMOTE_DIR=/

# ftp or ftps — use ftps if your host supports it.
FTP_PROTOCOL=ftp
